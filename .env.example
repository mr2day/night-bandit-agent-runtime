# Copy to `.env` and fill in. The runtime loads this in development via
# python-dotenv; production sets real environment variables. All keys are
# prefixed NB_ (see src/night_bandit/config.py).

# --- Server (the WS gateway the UI connects to) ---
NB_HOST=127.0.0.1
NB_PORT=3220
NB_WS_PATH=/v6/bandit

# --- Proposer LLM host (Box A, local) ---
NB_PROPOSER_WS_URL=ws://127.0.0.1:3213/v5/model
NB_PROPOSER_MODEL_ID=ministral-3:14b

# --- Verifier LLM host (Box B, LAN) ---
NB_VERIFIER_WS_URL=ws://192.168.0.194:3213/v5/model
NB_VERIFIER_MODEL_ID=qwen3.5:9b

# --- Persistence (required) ---
NB_PG_DSN=postgresql://night_bandit:CHANGE_ME@127.0.0.1:5432/night_bandit

# --- Tools (required for search_web / fetch_page) ---
NB_EXA_API_KEY=exa_xxxxxxxxxxxxxxxx

# --- Auth (IdP / OIDC) ---
NB_IDP_ISSUER=https://idpbase.swirlock.com/oidc
NB_IDP_AUDIENCE=https://api.gigi-the-robot.com
NB_IDP_JWKS_URI=https://idpbase.swirlock.com/oidc/jwks
# Dev-only: bypass JWT verification for localhost smoke tests. NEVER true in prod.
NB_DEV_BYPASS_AUTH=false

# --- Agent loop / context ---
NB_MAX_STEPS=8
NB_MAX_OUTPUT_TOKENS=4096
NB_PROPOSER_NUM_CTX=32768
